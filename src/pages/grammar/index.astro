---
import Layout from '../../layouts/Layout.astro';
import NotebookTabs from '../../components/NotebookTabs.astro';
import { guides } from '../../data/guides';

const categoryGuides = guides.filter((g) => g.category === 'Grammar');
---

<Layout
	title="Grammar"
	description="Grammar points and word pairs that trip up learners and native-language searchers alike, explained with real examples instead of just a rule."
>
	<div class="pt-2 md:pt-4">
		<NotebookTabs active="Grammar" />

		<div class="ruled-paper notebook-page">
			<header class="page-head">
				<p class="m-0 text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-[var(--flag-dark)]">Section</p>
				<h1 class="font-display mt-2 text-3xl font-bold text-[var(--ink)] md:text-4xl">Grammar</h1>
				<p class="mt-3 mb-0 max-w-2xl text-lg text-[var(--ink-soft)]">
					The comparisons that keep coming up because the rule alone never quite settles it — por vs
					para, preterite vs imperfect, and the rest. Each entry explains the actual distinction with
					examples, not just a label.
				</p>
			</header>

			{categoryGuides.length === 0 ? (
				<p class="page-head mt-10 text-sm text-[var(--ink-soft)]">Entries in this section are coming soon.</p>
			) : (
				<ol class="entry-list m-0 list-none p-0">
					{categoryGuides.map((g, i) => (
						<li>
							<a href={`/${g.slug}/`} class="entry-row no-underline">
								<span class="nb-num entry-num" aria-hidden="true">{i + 1}.</span>
								<span class="entry-body">
									<span class="font-display entry-title block text-[1.1rem] leading-snug font-bold text-[var(--ink)]">{g.title}</span>
									<span class="mt-0.5 block text-sm leading-relaxed text-[var(--ink-soft)]">{g.description}</span>
								</span>
							</a>
						</li>
					))}
				</ol>
			)}
		</div>
	</div>
</Layout>

<style>
	.notebook-page {
		padding: 2rem 1.25rem 2.5rem 0;
	}
	.page-head {
		padding-left: calc(var(--nb-margin) + 1rem);
	}
	.entry-list {
		margin-top: 2rem;
	}
	.entry-row {
		display: grid;
		grid-template-columns: var(--nb-margin) 1fr;
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--rule);
	}
	.entry-list li:last-child .entry-row {
		border-bottom: 0;
	}
	.entry-num {
		text-align: right;
		padding-right: 0.9rem;
		font-size: 1.05rem;
		line-height: 1.4;
	}
	.entry-body {
		padding-left: 1rem;
		padding-right: 0.25rem;
	}
	.entry-row:hover .entry-title {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
