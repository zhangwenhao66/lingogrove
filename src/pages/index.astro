---
import Layout from '../layouts/Layout.astro';
import NotebookTabs from '../components/NotebookTabs.astro';
import { guides, type GuideCategory } from '../data/guides';

const sorted = [...guides].sort((a, b) => b.updated.localeCompare(a.updated));

// Same link set as the old pillar grid (3 latest per category), presented as one
// notebook page of dated entries instead of card sections.
const CATEGORIES: GuideCategory[] = ['Grammar', 'Loanwords', 'Phrases', 'Conjugations'];
const picked = CATEGORIES.flatMap((c) => sorted.filter((g) => g.category === c).slice(0, 3));
const entries = [...picked].sort((a, b) => b.updated.localeCompare(a.updated));
---

<Layout>
	<div class="pt-2 md:pt-4">
		<NotebookTabs active="all" />

		<div class="ruled-paper notebook-page">
			<header class="page-head">
				<h1 class="font-display m-0 text-3xl leading-[1.15] font-bold tracking-tight text-[var(--ink)] md:text-4xl">
					A language reference for the moment you need one exact answer.
				</h1>
				<p class="mt-4 mb-0 max-w-xl text-[1rem] leading-relaxed text-[var(--ink-soft)]">
					Translations, loanword meanings, verb conjugations, and grammar explained in plain English —
					checked against real dictionaries and grammar references, not written from memory.
				</p>
			</header>

			<ol class="entry-list m-0 list-none p-0">
				{entries.map((g, i) => (
					<li>
						<a href={`/${g.slug}/`} class="entry-row no-underline">
							<span class="nb-num entry-num" aria-hidden="true">{i + 1}.</span>
							<span class="entry-body">
								<span class="rubric">{g.category}</span>
								<span class="font-display entry-title block text-[1.1rem] leading-snug font-bold text-[var(--ink)]">{g.title}</span>
								<span class="mt-0.5 block text-sm leading-relaxed text-[var(--ink-soft)]">{g.description}</span>
							</span>
						</a>
					</li>
				))}
			</ol>

			<p class="page-foot m-0 text-sm text-[var(--ink-soft)]">
				Older notes are filed under each tab above —
				<a href="/grammar/" class="text-[var(--flag-dark)] underline underline-offset-2">grammar</a>,
				<a href="/loanwords/" class="text-[var(--flag-dark)] underline underline-offset-2">loanwords</a>,
				<a href="/phrases/" class="text-[var(--flag-dark)] underline underline-offset-2">phrases</a>, and
				<a href="/conjugations/" class="text-[var(--flag-dark)] underline underline-offset-2">conjugations</a>.
			</p>
		</div>
	</div>
</Layout>

<style>
	.notebook-page {
		padding: 2rem 1.25rem 2.5rem 0;
	}
	.page-head,
	.page-foot {
		padding-left: calc(var(--nb-margin) + 1rem);
	}
	.page-foot {
		margin-top: 2rem;
	}
	.entry-list {
		margin-top: 2rem;
	}
	.entry-row {
		display: grid;
		grid-template-columns: var(--nb-margin) 1fr;
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--rule);
	}
	.entry-list li:last-child .entry-row {
		border-bottom: 0;
	}
	.entry-num {
		text-align: right;
		padding-right: 0.9rem;
		font-size: 1.05rem;
		line-height: 1.4;
	}
	.entry-body {
		padding-left: 1rem;
		padding-right: 0.25rem;
	}
	.entry-row:hover .entry-title {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
