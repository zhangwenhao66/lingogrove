---
import Layout from '../../layouts/Layout.astro';
import { guides } from '../../data/guides';

const categoryGuides = guides.filter((g) => g.category === 'Phrases');
---

<Layout
	title="Phrases"
	description="How to say common words, greetings, and phrases in other languages, with pronunciation notes and the regional differences that a straight translation misses."
>
	<p class="m-0 text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-[var(--flag-dark)]">Section</p>
	<h1 class="font-display mt-2 text-3xl font-bold text-[var(--ink)] md:text-4xl">Phrases</h1>
	<p class="mt-3 max-w-2xl text-lg text-[var(--ink)]/60">
		"How do you say X in Spanish" answers, done properly: the phrase, how to say it, and the
		regional or formality differences that a single-line translation glosses over.
	</p>

	{categoryGuides.length === 0 ? (
		<p class="mt-10 text-sm text-[var(--ink)]/40">Entries in this section are coming soon.</p>
	) : (
		<div class="mt-10 flex flex-col">
			{categoryGuides.map((g) => (
				<a href={`/${g.slug}/`} class="item border-b border-[var(--rule)] py-5 no-underline first:pt-0">
					<p class="m-0 text-lg font-bold leading-snug text-[var(--ink)] hover:underline">{g.title}</p>
					<p class="m-0 mt-1.5 text-sm text-[var(--ink)]/55">{g.description}</p>
				</a>
			))}
		</div>
	)}
</Layout>

<style>
	.item { display: block; transition: padding-left 0.15s ease; }
	.item:hover { padding-left: 0.5rem; }
</style>
