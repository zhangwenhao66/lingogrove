---
import Layout from '../../layouts/Layout.astro';
import { guides } from '../../data/guides';

const categoryGuides = guides.filter((g) => g.category === 'Loanwords');
---

<Layout
	title="Loanwords"
	description="What foreign words and phrases that have worked their way into English conversation actually mean, where they came from, and how to use them."
>
	<p class="m-0 text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-[var(--flag-dark)]">Section</p>
	<h1 class="font-display mt-2 text-3xl font-bold text-[var(--ink)] md:text-4xl">Loanwords</h1>
	<p class="mt-3 max-w-2xl text-lg text-[var(--ink)]/60">
		Words like schadenfreude, senpai, and déjà vu show up in English sentences without ever
		getting fully translated. Each entry covers the real meaning, the word it came from, and how
		native speakers actually use it.
	</p>

	{categoryGuides.length === 0 ? (
		<p class="mt-10 text-sm text-[var(--ink)]/40">Entries in this section are coming soon.</p>
	) : (
		<div class="mt-10 flex flex-col">
			{categoryGuides.map((g) => (
				<a href={`/${g.slug}/`} class="item border-b border-[var(--rule)] py-5 no-underline first:pt-0">
					<p class="m-0 text-lg font-bold leading-snug text-[var(--ink)] hover:underline">{g.title}</p>
					<p class="m-0 mt-1.5 text-sm text-[var(--ink)]/55">{g.description}</p>
				</a>
			))}
		</div>
	)}
</Layout>

<style>
	.item { display: block; transition: padding-left 0.15s ease; }
	.item:hover { padding-left: 0.5rem; }
</style>
