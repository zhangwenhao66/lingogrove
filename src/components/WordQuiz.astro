---
// "Fill in the blank" quiz island for Spanish confusable-word pairs (por/para, ser/estar,
// preterite/imperfect, saber/conocer) -- same "logic function + thin UI wrapper" split as
// DayAlmanac's DayQuiz.astro, no Preact/React/Vue dependency added.
//
// Why this exists: an AI Overview can answer "is it por or para in this sentence" in one
// sentence, so a visitor never needs to click through. A quiz that requires picking an
// answer before the verdict + explanation appear can't be resolved that way -- see
// 填空判断题-实施方案_20260806.md. DayAlmanac and LingoGrove were the only two
// traffic-matrix sites with zero interactive element as of 2026-08-06; DayAlmanac's
// content is true/false claims (DayQuiz.astro), LingoGrove's is confusable word pairs, so
// this uses a different interaction (two-choice fill-in-the-blank) rather than reusing
// DayQuiz's true/false mechanic verbatim.
//
// The full item deck is serialized into a data-* attribute at build time, and
// pickQuizSet(...) -- the pure, unit-tested function in src/lib/wordQuiz.ts -- runs in
// the browser to draw this visitor's set so repeat visits don't always see the same
// items in the same order.
import { wordQuizItems } from '../data/wordQuiz';

interface Props {
	/** How many items to draw into a single play-through. */
	count?: number;
}

const { count = 12 } = Astro.props;
const deckJson = JSON.stringify(wordQuizItems);
---

<div class="word-quiz" data-deck={deckJson} data-count={count}>
	<div id="word-quiz-progress" class="mb-4 flex items-center justify-between text-xs font-semibold uppercase tracking-[0.12em] text-[var(--ink)]/50">
		<span id="word-quiz-position">Question 1 of 12</span>
		<span id="word-quiz-score">Score: 0</span>
	</div>

	<div id="word-quiz-card" class="panel px-6 py-6">
		<p class="rubric m-0">Fill in the blank</p>
		<p id="word-quiz-sentence" class="font-display m-0 mt-3 text-xl font-semibold leading-snug text-[var(--ink)]">&nbsp;</p>
		<p id="word-quiz-translation" class="mt-1.5 mb-0 text-sm italic text-[var(--ink)]/55"></p>

		<div id="word-quiz-choices" class="mt-5 flex flex-col gap-2.5 sm:flex-row">
			<button type="button" data-choice="0" class="word-quiz-choice-btn flex-1 rounded-[6px] border border-[var(--rule)] px-4 py-3 text-base font-semibold text-[var(--ink)]/80 transition-colors hover:border-[var(--flag)] hover:text-[var(--flag-dark)]"></button>
			<button type="button" data-choice="1" class="word-quiz-choice-btn flex-1 rounded-[6px] border border-[var(--rule)] px-4 py-3 text-base font-semibold text-[var(--ink)]/80 transition-colors hover:border-[var(--flag)] hover:text-[var(--flag-dark)]"></button>
		</div>

		<div id="word-quiz-reveal" class="mt-5" hidden>
			<p id="word-quiz-verdict" class="font-display m-0 text-base font-bold"></p>
			<p id="word-quiz-explanation" class="mt-2 mb-0 text-sm leading-relaxed text-[var(--ink)]/75"></p>
			<a id="word-quiz-source-link" href="#" class="mt-3 inline-block text-sm font-semibold text-[var(--flag-dark)] no-underline hover:underline">Read the full explanation &rarr;</a>
			<div class="mt-5">
				<button id="word-quiz-next" type="button" class="rounded-[6px] border border-[var(--rule)] px-4 py-2 text-xs font-semibold uppercase tracking-wide text-[var(--ink)]/70 hover:border-[var(--flag)] hover:text-[var(--flag-dark)]">
					Next question &rarr;
				</button>
			</div>
		</div>
	</div>

	<div id="word-quiz-done" class="panel mt-6 rounded-[10px] px-6 py-6 text-center" hidden>
		<p class="rubric m-0">Round complete</p>
		<p id="word-quiz-final-score" class="font-display m-0 mt-2 text-2xl font-bold text-[var(--ink)]"></p>
		<button id="word-quiz-restart" type="button" class="mt-4 rounded-[6px] border border-[var(--rule)] px-4 py-2 text-xs font-semibold uppercase tracking-wide text-[var(--ink)]/70 hover:border-[var(--flag)] hover:text-[var(--flag-dark)]">
			Play again with a new set &rarr;
		</button>
	</div>
</div>

<script>
	import { pickQuizSet, splitAtBlank } from '../lib/wordQuiz';
	import type { WordQuizItem } from '../data/wordQuiz';

	document.querySelectorAll<HTMLElement>('.word-quiz').forEach((root) => {
		const deckRaw = root.dataset.deck;
		if (!deckRaw) return;
		const deck: WordQuizItem[] = JSON.parse(deckRaw);
		const count = Number(root.dataset.count) || 12;

		const positionEl = root.querySelector<HTMLElement>('#word-quiz-position');
		const scoreEl = root.querySelector<HTMLElement>('#word-quiz-score');
		const sentenceEl = root.querySelector<HTMLElement>('#word-quiz-sentence');
		const translationEl = root.querySelector<HTMLElement>('#word-quiz-translation');
		const choicesEl = root.querySelector<HTMLElement>('#word-quiz-choices');
		const revealEl = root.querySelector<HTMLElement>('#word-quiz-reveal');
		const verdictEl = root.querySelector<HTMLElement>('#word-quiz-verdict');
		const explanationEl = root.querySelector<HTMLElement>('#word-quiz-explanation');
		const sourceLinkEl = root.querySelector<HTMLAnchorElement>('#word-quiz-source-link');
		const nextBtn = root.querySelector<HTMLButtonElement>('#word-quiz-next');
		const cardEl = root.querySelector<HTMLElement>('#word-quiz-card');
		const doneEl = root.querySelector<HTMLElement>('#word-quiz-done');
		const finalScoreEl = root.querySelector<HTMLElement>('#word-quiz-final-score');
		const restartBtn = root.querySelector<HTMLButtonElement>('#word-quiz-restart');
		const choiceButtons = root.querySelectorAll<HTMLButtonElement>('.word-quiz-choice-btn');

		if (
			!positionEl || !scoreEl || !sentenceEl || !translationEl || !choicesEl || !revealEl ||
			!verdictEl || !explanationEl || !sourceLinkEl || !nextBtn || !cardEl || !doneEl ||
			!finalScoreEl || !restartBtn
		) {
			return;
		}

		let set: WordQuizItem[] = [];
		let index = 0;
		let score = 0;
		let answered = false;

		function startRound() {
			set = pickQuizSet(deck, count);
			index = 0;
			score = 0;
			answered = false;
			doneEl!.hidden = true;
			cardEl!.hidden = false;
			showQuestion();
		}

		function showQuestion() {
			const item = set[index];
			answered = false;
			positionEl!.textContent = `Question ${index + 1} of ${set.length}`;
			scoreEl!.textContent = `Score: ${score}`;

			const [before, after] = splitAtBlank(item.sentence);
			sentenceEl!.textContent = '';
			sentenceEl!.append(
				document.createTextNode(before),
				(() => {
					const span = document.createElement('span');
					span.textContent = '_____';
					span.style.color = 'var(--flag-dark)';
					span.style.borderBottom = '2px solid var(--flag)';
					return span;
				})(),
				document.createTextNode(after),
			);
			translationEl!.textContent = item.translation;

			choicesEl!.hidden = false;
			revealEl!.hidden = true;
			choiceButtons.forEach((btn, i) => {
				btn.disabled = false;
				btn.textContent = item.choices[i];
				btn.classList.remove('word-quiz-choice-correct', 'word-quiz-choice-wrong');
			});
		}

		function handleChoice(choiceIndex: number) {
			if (answered) return;
			answered = true;

			const item = set[index];
			const correct = choiceIndex === item.correctIndex;
			if (correct) score += 1;

			choiceButtons.forEach((btn, i) => {
				btn.disabled = true;
				if (i === item.correctIndex) btn.classList.add('word-quiz-choice-correct');
				else if (i === choiceIndex) btn.classList.add('word-quiz-choice-wrong');
			});

			verdictEl!.textContent = correct ? 'Correct!' : `Not quite — it's "${item.choices[item.correctIndex]}".`;
			verdictEl!.style.color = correct ? 'var(--flag-dark)' : 'var(--ink)';
			explanationEl!.textContent = item.explanation;
			sourceLinkEl!.href = `/${item.sourceSlug}/`;
			sourceLinkEl!.textContent = `Read the full explanation: ${item.sourceTitle} →`;

			scoreEl!.textContent = `Score: ${score}`;
			revealEl!.hidden = false;
		}

		function nextQuestion() {
			index += 1;
			if (index >= set.length) {
				cardEl!.hidden = true;
				doneEl!.hidden = false;
				finalScoreEl!.textContent = `${score} / ${set.length} correct`;
				return;
			}
			showQuestion();
		}

		choiceButtons.forEach((btn) => {
			btn.addEventListener('click', () => handleChoice(Number(btn.dataset.choice)));
		});
		nextBtn!.addEventListener('click', nextQuestion);
		restartBtn!.addEventListener('click', startRound);

		startRound();
	});
</script>

<style>
	.word-quiz-choice-correct {
		border-color: var(--flag) !important;
		background-color: color-mix(in srgb, var(--flag) 10%, transparent);
		color: var(--flag-dark) !important;
	}
	.word-quiz-choice-wrong {
		border-color: var(--ink) !important;
		opacity: 0.55;
	}
</style>
