---
import { SITE_TITLE } from '../consts';
---

<header class="site-header border-b border-[var(--rule)] bg-[var(--paper)]">
	<nav class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-2 px-4">
		<a href="/" class="flex shrink-0 items-center gap-2 no-underline" aria-label={`${SITE_TITLE} home`}>
			<!-- A small grove: three simple round canopies over one trunk line. -->
			<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<rect x="11" y="14" width="2" height="7" fill="var(--flag-dark)"/>
				<circle cx="12" cy="10.5" r="6" fill="var(--flag)"/>
				<circle cx="5.5" cy="13" r="4" fill="var(--flag)" opacity="0.75"/>
				<circle cx="18.5" cy="13" r="4" fill="var(--flag)" opacity="0.75"/>
			</svg>
			<span class="font-display text-[1.35rem] font-extrabold tracking-tight text-[var(--ink)]">{SITE_TITLE}</span>
		</a>

		<div class="hidden items-center gap-6 md:flex">
			<a href="/grammar/" class="nav-link text-[0.9rem] font-medium text-[var(--ink)]/75 no-underline">Grammar</a>
			<a href="/loanwords/" class="nav-link text-[0.9rem] font-medium text-[var(--ink)]/75 no-underline">Loanwords</a>
			<a href="/phrases/" class="nav-link text-[0.9rem] font-medium text-[var(--ink)]/75 no-underline">Phrases</a>
			<a href="/conjugations/" class="nav-link text-[0.9rem] font-medium text-[var(--ink)]/75 no-underline">Conjugations</a>
			<a href="/about/" class="nav-link text-[0.9rem] font-medium text-[var(--ink)]/75 no-underline">About</a>
		</div>

		<button
			id="menu-toggle"
			class="flex h-9 w-9 flex-col items-center justify-center gap-1.5 md:hidden"
			aria-label="Open menu"
			aria-expanded="false"
			aria-controls="mobile-menu"
		>
			<span class="h-px w-5 bg-[var(--ink)]"></span>
			<span class="h-px w-5 bg-[var(--ink)]"></span>
			<span class="h-px w-5 bg-[var(--ink)]"></span>
		</button>
	</nav>

	<div id="mobile-menu" class="hidden border-t border-[var(--rule)] bg-[var(--paper)] md:hidden">
		<nav class="flex flex-col px-4 py-2">
			<a href="/grammar/" class="border-b border-[var(--rule)] py-3 text-sm text-[var(--ink)]/80 no-underline">Grammar</a>
			<a href="/loanwords/" class="border-b border-[var(--rule)] py-3 text-sm text-[var(--ink)]/80 no-underline">Loanwords</a>
			<a href="/phrases/" class="border-b border-[var(--rule)] py-3 text-sm text-[var(--ink)]/80 no-underline">Phrases</a>
			<a href="/conjugations/" class="border-b border-[var(--rule)] py-3 text-sm text-[var(--ink)]/80 no-underline">Conjugations</a>
			<a href="/about/" class="py-3 text-sm text-[var(--ink)]/80 no-underline">About</a>
		</nav>
	</div>
</header>

<script>
	const toggle = document.getElementById('menu-toggle')!;
	const menu = document.getElementById('mobile-menu')!;
	toggle.addEventListener('click', () => {
		const open = menu.classList.toggle('hidden');
		toggle.setAttribute('aria-expanded', String(!open));
	});
</script>

<style>
	/* Double hairline under the header: the notebook cover's stitched edge. */
	.site-header {
		box-shadow: 0 2px 0 rgba(47, 107, 71, 0.22);
	}
	.nav-link {
		position: relative;
	}
	/* Hover cue: a thin green pen underline, in keeping with the ruled-paper motif. */
	.nav-link::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -4px;
		height: 2px;
		background: var(--flag);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.18s ease;
	}
	.nav-link:hover {
		color: var(--ink);
	}
	.nav-link:hover::after {
		transform: scaleX(1);
	}
</style>
