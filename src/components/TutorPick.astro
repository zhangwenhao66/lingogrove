---
// italki tutor callout for grammar / conjugation / phrase pages. Renders nothing for
// loanword pages and for languages italki does not teach. See src/lib/affiliate.ts
// for the rules; do not put the italki link anywhere else on the page.
import { tutorPick, ITALKI_REF_URL, ITALKI_DISCLOSURE } from '../lib/affiliate';

interface Props {
	guide: { category: string; language?: string };
}

const { guide } = Astro.props;
const pick = tutorPick(guide);
---

{pick && (
	<aside class="panel mt-9 px-5 py-5 md:px-6" aria-labelledby="tutor-pick-heading">
		<p class="rubric m-0">Speak it, not just read it</p>
		<p id="tutor-pick-heading" class="font-display m-0 mt-2 text-[1.15rem] font-bold leading-snug text-[var(--ink)]">
			{pick.heading}
		</p>
		<p class="mt-2 mb-0 text-[0.95rem] leading-relaxed text-[var(--ink)]/80">{pick.body}</p>
		<p class="mt-3 mb-0">
			<a
				href={ITALKI_REF_URL}
				target="_blank"
				rel="sponsored nofollow noopener"
				class="inline-block rounded-[4px] border border-[var(--flag)] px-4 py-2 text-sm font-semibold text-[var(--flag-dark)] no-underline hover:bg-[var(--flag)] hover:text-white"
			>{pick.cta} &rarr;</a>
		</p>
		<p class="mt-3 mb-0 text-xs leading-relaxed text-[var(--ink-soft)]">{ITALKI_DISCLOSURE}</p>
	</aside>
)}
